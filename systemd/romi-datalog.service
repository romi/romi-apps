[Unit]
Description=Romi datalog service
ConditionPathExists=/home/romi/romi-apps/build/bin/romi-datalog
After=network.target
After=systemd-user-sessions.service
After=network-online.target

[Service]
User=romi
Type=forking
ExecStart=/home/romi/romi-apps/systemd/romi-datalog-start.sh
ExecStop=/home/romi/romi-apps/systemd/romi-datalog-stop.sh

[Install]
WantedBy=multi-user.target


